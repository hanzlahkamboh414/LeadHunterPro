# =====================================================================
# LeadHunter Pro — PRODUCTION .env template (Hostinger VPS)
#
# Copy this to /opt/leadhunter/.env on the VPS and fill in the REAL
# values. This file is a TEMPLATE — no live secrets. Never upload real
# keys anywhere public.
#
# The backend ALSO reads runtime_keys.json from backend/output/ (the
# admin screen's key manager). Keys set there override .env at boot.
# Either mechanism is fine; keep the other blank to avoid confusion.
# =====================================================================

# --- App --------------------------------------------------------------
APP_NAME=LeadHunter Pro
APP_VERSION=1.0.0
# REQUIRED (no default in config.py — the app refuses to boot without it).
# Absolute SQLite path: sqlite://// plus the full filesystem path.
DATABASE_URL=sqlite:////opt/leadhunter/backend/leadhunter.db

# --- AI (RouterProvider — speaks the OpenAI-compatible protocol) ------
# AI_PROVIDER=router is what the live server runs on.
AI_PROVIDER=router
AI_MODEL=agnes-2.5-flash
# If you use .env for the router key instead of runtime_keys.json, set the
# PRIMARY key here — RouterProvider reads settings.AI_API_KEY only (the _2/_3
# suffixed keys are a separate multi-key pool, not a fallback for the primary):
# AI_API_KEY=REPLACE_WITH_REAL_KEY

# --- Search providers (optional here — the runtime key store is the
#     live path; e.g. a Tavily key set in the admin panel) -------------
# TAVILY_SEARCH_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SEARXNG_URL=

# --- Leads API optional auth (M12 baseline) ---------------------------
# Set a real key to require X-API-Key on /api/v1/leads. Empty = open.
# LEADS_API_KEY=

# --- Tuning (defaults match the tuned local server) -------------------
AI_TIMEOUT_S=60
LEADS_CONCURRENCY=3
LEAD_REENRICHMENT_COOLDOWN_SECONDS=86400

# --- Search cache (SQLite, under backend/output/) ---------------------
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_DAYS=14
SEARCH_CACHE_EXTRACT_TTL_DAYS=30
# --- User authentication (JWT) — NEW since 2026-09-10 -----------------
# REQUIRED in production: the app enforces login; users table lives in
# backend/output/users.db. The admin account (admin4269) is auto-seeded on
# first boot with its password from ADMIN_SEED_PASSWORD below — change the
# password right after first login.
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX
AUTH_TOKEN_EXPIRE_HOURS=24
# NOTE: the admin account (admin4269 / 223344) is auto-seeded on FIRST boot
# with that fixed password — change it immediately after first login via the
# "Forgot password" reset flow (username-only reset, no email needed).
