temp/
tmp/

# Cache
.cache/

# pytest basetemp override (see roadmap D6). Dedicated throwaway: pytest WIPES
# this directory at the start of every run, so never point --basetemp at a real
# folder and never put anything here you want to keep.
.pytest_tmp/