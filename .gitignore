service-account.json

# Real lead data — pipeline output (company names, contacts, emails).
# Never commit this: it is real business data about real people, and it is
# regenerated by every run, so it has no value in history. Listed here rather
# than left to discipline because `git add -A` is the natural command to type
# and would otherwise stage the whole folder.
backend/output/

# Generated discovery artifact — UTF-16 scrape log of the Texas CMBL page
# from the plan-holder discovery runner. No code reads it; it is regenerated
# every crawl, so it has no value in history (same policy as backend/output/).
backend/cmbl_links.txt

